{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "frontend/**/*.{ts,tsx,js,jsx,cjs,mjs}",
      "!frontend/node_modules",
      "!frontend/dist",
      "!frontend/.astro",
      "!frontend/src/components/starwind",
      "!frontend/src/lib/utils/starwind"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": { "enabled": false },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "frontend/**/*.{ts,tsx,js,jsx,cjs,mjs,css,json,jsonc}",
      "!frontend/node_modules",
      "!frontend/dist",
      "!frontend/.astro",
      "!frontend/src/data",
      "!frontend/src/components/starwind",
      "!frontend/src/lib/utils/starwind"
    ]
  },
  "formatter": {
    "enabled": true,
    "includes": ["frontend/**/*.{css,json,jsonc}"],
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}

---
import { Info } from '@lucide/astro';
import { Tooltip, TooltipContent, TooltipTrigger } from '@/shared/components/ui/starwind/tooltip';

interface Props {
  title: string;
  help?: string;
}
const { title, help } = Astro.props;
---

<h2 class="flex flex-wrap items-center gap-2 text-h3">
  {title}
  {
    help && (
      <Tooltip>
        <TooltipTrigger>
          <button
            type="button"
            class="text-muted-foreground transition-colors hover:text-primary motion-reduce:transition-none"
            aria-label={`About ${title}`}
          >
            <Info size={15} />
          </button>
        </TooltipTrigger>
        <TooltipContent side="right" align="start">
          {help}
        </TooltipContent>
      </Tooltip>
    )
  }
</h2>

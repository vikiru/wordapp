---
interface Props {
	letters: string[];
}

const { letters } = Astro.props;
---
<nav
	class="sticky top-24 hidden max-h-[calc(100dvh-8rem)] flex-col items-center gap-1 self-start overflow-y-auto lg:flex"
	aria-label="Word letters"
>
	{letters.map((letter) => (
		<a
			data-letter-link
			data-letter={letter}
			href={`#section-${letter}`}
			class="flex h-8 w-8 items-center justify-center rounded text-sm text-muted-foreground transition-colors outline-none motion-reduce:transition-none focus-visible:ring-3 focus-visible:ring-outline/50 hover:text-primary"
		>
			{letter}
		</a>
	))}
</nav>

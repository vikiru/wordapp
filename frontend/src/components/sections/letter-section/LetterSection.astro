---
import type { CollectionEntry } from 'astro:content';
import { slugify } from '@/lib/slugify';
import { shortDate } from '@/lib/functions/date';
import WordCard from '@/components/sections/word-card/WordCard.astro';

interface Props {
	letter: string;
	entries: CollectionEntry<'words'>[];
}

const { letter, entries } = Astro.props;
---
<section
	data-letter-section
	data-letter={letter}
	id={`section-${letter}`}
	class="relative flex scroll-mt-24 flex-col gap-4"
>
	<span
		aria-hidden="true"
		class="pointer-events-none absolute top-0 right-0 z-0 font-script text-[8rem] leading-none text-primary/10 select-none"
	>
		{letter}
	</span>
	<div class="relative z-10 flex items-baseline justify-between border-b border-border pb-2">
		<h2 class="text-h3 text-primary">{letter}</h2>
		<span class="text-small uppercase tracking-widest text-muted-foreground">
			{entries.length} {entries.length === 1 ? 'Entry' : 'Entries'}
		</span>
	</div>
	<div class="grid grid-cols-1 gap-4 md:grid-cols-2">
		{entries.map((w) => (
			<WordCard
				word={w.data.word}
				pos={w.data.pos_tags}
				definition={w.data.senses[0]?.definition ?? ''}
				date={shortDate(w.data.generation_date)}
				href={`/words/${slugify(w.data.word)}`}
				dataId={w.id}
				dataPos={w.data.pos_tags[0]?.toLowerCase() ?? ''}
			/>
		))}
	</div>
</section>

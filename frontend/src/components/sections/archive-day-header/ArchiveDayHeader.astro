---
import { Badge } from '@/components/starwind/badge';
import { formatShortDate } from '@/lib/functions/date';

interface Props {
	date: string;
	count: number;
}

const { date, count } = Astro.props;
---
<div class="flex flex-col gap-4 pt-6">
	<div class="flex flex-wrap items-baseline justify-between gap-3">
		<h1 class="text-h1">{formatShortDate(date)}</h1>
	</div>
</div>
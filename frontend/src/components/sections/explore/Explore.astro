---
import { Archive, ArrowUpRight, BookOpen, CalendarDays } from '@lucide/astro';

const sections = [
	{
		title: "Today's words",
		description: 'Ten fresh coinages each day: senses, etymology, and pronunciation, ready to speak.',
		href: '/words/today/',
		icon: CalendarDays,
	},
	{
		title: 'Glossary',
		description: 'Every word the project has generated, browsable letter by letter with instant full-text search.',
		href: '/glossary/',
		icon: BookOpen,
	},
	{
		title: 'Archive',
		description: 'The day-by-day ledger of the lexicon: revisit any day since the project began.',
		href: '/archive/',
		icon: Archive,
	},
];
---
<section class="flex flex-col gap-4">
	<div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-border pb-2">
		<h2 class="text-h3">Explore</h2>
	</div>
	<div class="grid grid-cols-1 gap-4 md:grid-cols-3">
		{sections.map((s) => (
			<a
				href={s.href}
				class="group flex flex-col gap-4 rounded-lg border border-border bg-card p-6 transition-all duration-300 hover:-translate-y-0.5 hover:border-primary/50 hover:shadow-glow motion-reduce:transition-none motion-reduce:transform-none focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-outline/50"
			>
				<div class="flex items-center justify-between">
					<span class="flex size-10 items-center justify-center rounded-md border border-border bg-secondary text-primary">
						<s.icon class="size-5" />
					</span>
					<ArrowUpRight class="size-5 text-muted-foreground transition-all group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-primary motion-reduce:transition-none motion-reduce:transform-none" aria-hidden="true" />
				</div>
				<div class="flex flex-col gap-2">
					<h3 class="text-h3">{s.title}</h3>
					<p class="font-serif leading-relaxed text-muted-foreground transition-colors group-hover:text-foreground motion-reduce:transition-none">
						{s.description}
					</p>
				</div>
			</a>
		))}
	</div>
</section>

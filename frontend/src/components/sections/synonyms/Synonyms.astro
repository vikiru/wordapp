---
import type { WordRelation } from '@/types/word';
import { Item, ItemDescription, ItemTitle } from '@/components/starwind/item';
import SectionHeader from '@/components/SectionHeader.astro';
import { capitalize } from '@/lib/functions/string';

interface Props {
  synonyms: WordRelation[];
}

const { synonyms } = Astro.props;
---

<section class="flex flex-col gap-3">
  <SectionHeader title="Synonyms" help="Words with the same or closely related meanings." />
  <ul class="flex flex-col gap-2">
    {
      synonyms.map((syn) => (
        <Item as="li" variant="outline">
          <ItemTitle>{syn.word}</ItemTitle>
          <ItemDescription>{syn.differentiator ?? capitalize(syn.part_of_speech)}</ItemDescription>
        </Item>
      ))
    }
  </ul>
</section>

---
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from '@/components/starwind/breadcrumb';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
---

<Breadcrumb aria-label="Breadcrumb">
  <BreadcrumbList>
    {
      crumbs.flatMap((crumb, i) => [
        i > 0 ? <BreadcrumbSeparator>/</BreadcrumbSeparator> : null,
        <BreadcrumbItem>
          {crumb.href ? (
            <BreadcrumbLink href={crumb.href}>{crumb.label}</BreadcrumbLink>
          ) : (
            <BreadcrumbPage>{crumb.label}</BreadcrumbPage>
          )}
        </BreadcrumbItem>,
      ])
    }
  </BreadcrumbList>
</Breadcrumb>

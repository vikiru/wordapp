---
const year = new Date().getFullYear();
const links = [
	{ href: '/words/today/', label: 'Today' },
	{ href: '/glossary/', label: 'Glossary' },
	{ href: '/archive/', label: 'Archive' },
];
---
<footer class="border-t border-border bg-background">
	<div class="mx-auto flex w-full max-w-6xl flex-col gap-6 px-4 py-10">
		<div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
			<div class="flex max-w-sm flex-col gap-2">
				<a
					class="text-lg font-semibold tracking-tight text-foreground transition-colors hover:text-primary focus-visible:outline-none motion-reduce:transition-none focus-visible:ring-3 focus-visible:ring-outline/50"
					href="/"
				>
					Wordapp
				</a>
				<p class="text-sm text-muted-foreground">
					A scholarly dictionary, grown one word at a time. Every day a new word is defined, pronounced, and
					added to the lexicon.
				</p>
			</div>
			<nav class="flex flex-wrap items-center gap-x-6 gap-y-2" aria-label="Browse">
				{links.map((link) => (
					<a class="text-sm text-muted-foreground transition-colors hover:text-primary focus-visible:outline-none motion-reduce:transition-none focus-visible:ring-3 focus-visible:ring-outline/50" href={link.href}>
						{link.label}
					</a>
				))}
			</nav>
		</div>
		<div class="flex flex-col gap-2 border-t border-border/50 pt-4 sm:flex-row sm:items-center sm:justify-between">
			<p class="text-sm text-muted-foreground">© {year} Wordapp. All rights reserved.</p>
			<a class="text-sm text-muted-foreground transition-colors hover:text-primary focus-visible:outline-none motion-reduce:transition-none focus-visible:ring-3 focus-visible:ring-outline/50" href="/feed.xml" rel="alternate" type="application/rss+xml">
				RSS feed
			</a>
		</div>
	</div>
</footer>

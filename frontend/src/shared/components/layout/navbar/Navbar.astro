---
import Logo from '@/shared/components/layout/logo/Logo.astro';
import ThemeToggle from '@/shared/components/ThemeToggle.astro';

const links = [
  { href: '/words/today/', label: 'Today' },
  { href: '/glossary/', label: 'Glossary' },
  { href: '/archive/', label: 'Archive' },
];
const pathname = Astro.url.pathname;
const isActive = (href: string) => pathname === href || pathname.startsWith(href);
---

<header class="sticky top-0 z-40 border-b border-border bg-background">
  <nav class="mx-auto flex w-full max-w-6xl flex-wrap items-center gap-x-6 gap-y-3 px-4 py-3">
    <Logo />
    <div class="ml-auto flex flex-wrap items-center gap-5">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              'text-sm transition-colors hover:text-foreground focus-visible:outline-none motion-reduce:transition-none focus-visible:ring-3 focus-visible:ring-outline/50',
              isActive(link.href) ? 'font-semibold text-primary' : 'text-muted-foreground',
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <ThemeToggle class="shrink-0" />
    </div>
  </nav>
</header>

---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { webSiteJsonLd } from '@/lib/seo/jsonld';
import Hero from '@/components/sections/hero/Hero.astro';
import TodaysWord from '@/components/sections/todays-word/TodaysWord.astro';
import Explore from '@/components/sections/explore/Explore.astro';

const wotd = (await getCollection('wotd'))[0]?.data;
---

<BaseLayout
  title="Wordapp: A scholarly dictionary, grown one word at a time"
  description="A scholarly dictionary grown one word at a time. Every day a new word is coined, defined, pronounced, and added to the lexicon."
  jsonLd={[webSiteJsonLd()]}
  wide
>
  <Hero />
  {wotd && <TodaysWord word={wotd} />}
  <Explore />
</BaseLayout>

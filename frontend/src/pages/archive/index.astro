---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArchiveHeader from '@/components/archive/ArchiveHeader.astro';
import ArchiveListing from '@/components/archive/ArchiveListing.astro';
import { breadcrumbJsonLd } from '@/lib/seo/jsonld';
import { ARCHIVE_CARDS_PER_PAGE } from '@/lib/functions/pagination';

const archive: CollectionEntry<'archive'>[] = (await getCollection('archive')).toSorted((a, b) =>
  a.id.localeCompare(b.id)
);
const totalWords = archive.reduce((sum, day) => sum + day.data.length, 0);
const totalPages = Math.max(1, Math.ceil(archive.length / ARCHIVE_CARDS_PER_PAGE));
const pageHref = (n: number) => (n === 1 ? '/archive/' : `/archive/page/${n}`);
---

<BaseLayout
  title="Archive"
  description="Explore Wordapp’s archive of daily word generations."
  jsonLd={[
    breadcrumbJsonLd([
      { name: 'Home', path: '/' },
      { name: 'Archive', path: '/archive/' },
    ]),
  ]}
  wide
>
  <ArchiveHeader dayCount={archive.length} wordCount={totalWords} />
  <ArchiveListing archive={archive} page={1} totalPages={totalPages} pageHref={pageHref} />
</BaseLayout>

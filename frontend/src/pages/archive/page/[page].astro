---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArchiveHeader from '@/components/archive/ArchiveHeader.astro';
import ArchiveListing from '@/components/archive/ArchiveListing.astro';
import { breadcrumbJsonLd } from '@/lib/seo/jsonld';
import { clampPage, ARCHIVE_CARDS_PER_PAGE } from '@/lib/functions/pagination';

export async function getStaticPaths() {
  const archive = await getCollection('archive');
  const totalPages = Math.max(1, Math.ceil(archive.length / ARCHIVE_CARDS_PER_PAGE));
  return Array.from({ length: totalPages - 1 }, (_, i) => ({ params: { page: String(i + 2) } }));
}

const { page } = Astro.params;
const archive: CollectionEntry<'archive'>[] = (await getCollection('archive')).toSorted((a, b) =>
  a.id.localeCompare(b.id)
);
const totalWords = archive.reduce((sum, day) => sum + day.data.length, 0);
const totalPages = Math.max(1, Math.ceil(archive.length / ARCHIVE_CARDS_PER_PAGE));
const current = clampPage(Number(page), totalPages);
const pageHref = (n: number) => (n === 1 ? '/archive/' : `/archive/page/${n}`);
---

<BaseLayout
  title={`Archive — Page ${current}`}
  description={`Explore page ${current} of Wordapp’s daily word generation archive.`}
  jsonLd={[
    breadcrumbJsonLd([
      { name: 'Home', path: '/' },
      { name: 'Archive', path: '/archive/' },
    ]),
  ]}
  wide
>
  <ArchiveHeader dayCount={archive.length} wordCount={totalWords} />
  <ArchiveListing archive={archive} page={current} totalPages={totalPages} pageHref={pageHref} />
</BaseLayout>

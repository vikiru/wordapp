---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { dayListJsonLd, breadcrumbJsonLd } from '@/lib/seo/jsonld';
import WordOfDay from '@/shared/components/WordOfDay.astro';
import TodayHeader from '@/components/today/TodayHeader.astro';
import TodayWords from '@/components/today/TodayWords.astro';

const wotd = (await getCollection('wotd'))[0]?.data;
const words: CollectionEntry<'words_today'>[] = (await getCollection('words_today')).toSorted((a, b) =>
  a.data.word.localeCompare(b.data.word)
);
---

<BaseLayout
  title="Today's Words"
  description="Explore today’s new words, each defined, pronounced, and added to the Wordapp lexicon."
  jsonLd={[
    dayListJsonLd(
      words.map((w) => w.data.word),
      '/words/today/'
    ),
    breadcrumbJsonLd([
      { name: 'Home', path: '/' },
      { name: "Today's words", path: '/words/today/' },
    ]),
  ]}
  wide
>
  <TodayHeader />
  {wotd && <WordOfDay word={wotd} />}
  {words.length > 0 && <TodayWords words={words} />}
</BaseLayout>

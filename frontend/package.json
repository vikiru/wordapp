{
  "name": "frontend",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "lint": "pnpm oxlint && pnpm biome check",
    "lint:oxlint": "oxlint",
    "lint:biome": "biome check",
    "format": "pnpm prettier --write \"**/*.astro\" && pnpm oxfmt --write . && pnpm biome format --write .",
    "typecheck": "tsc --noEmit",
    "prebuild": "node --import tsx src/lib/validation/validate-data.ts && node --import tsx src/features/search/build-index.ts",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "astro-check": "astro check"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/charis-sil": "^5.3.0",
    "@fontsource/crimson-text": "^5.3.0",
    "@fontsource/fragment-mono": "^5.3.0",
    "@fontsource/pinyon-script": "^5.3.0",
    "@lucide/astro": "^1.30.0",
    "@tabler/icons": "^3.46.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.0",
    "astro-seo": "^1.1.0",
    "embla-carousel": "^8.6.0",
    "flexsearch": "^0.8.212",
    "lodash": "^4.18.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/lodash": "~4.17.25",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.3.3",
    "prettier-plugin-astro": "^0.14.1",
    "schema-dts": "^2.0.0",
    "tsx": "^4.23.8",
    "typescript": "^5.9.3"
  }
}

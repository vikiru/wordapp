{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "lib": ["ES2015", "DOM"],
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "noEmit": true,
    "sourceMap": false,
    "inlineSourceMap": false,
    "declaration": false
  }
}

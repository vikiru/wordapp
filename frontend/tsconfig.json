{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "src/shared/components/ui/starwind", "src/shared/components/ui/starwind"],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "noEmit": true,
    "sourceMap": false,
    "inlineSourceMap": false,
    "declaration": false
  }
}

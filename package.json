{
	"name": "wordapp",
	"version": "0.1.0",
	"private": true,
	"description": "",
	"keywords": [],
	"license": "MIT",
	"author": "Visakan Kirubakaran",
	"scripts": {
		"dev": "pnpm --filter frontend dev",
		"start": "pnpm --filter frontend dev",
		"build": "pnpm --filter frontend build",
		"build-frontend": "pnpm --filter frontend build",
		"preview": "pnpm --filter frontend preview",
		"astro": "pnpm --filter frontend astro",
		"lint": "pnpm oxlint && pnpm biome check",
		"lint:oxlint": "pnpm oxlint",
		"lint:biome": "pnpm biome check",
		"format": "pnpm exec prettier --write 'src/' '*.astro' '*/*.json' '*/*.yaml' '*/*.yml' '*/*.md' && pnpm biome format",
		"format:check": "pnpm exec prettier --check 'src/' '*.astro' '*/*.json' '*/*.yaml' '*/*.yml' '*/*.md' && pnpm biome check",
		"typecheck": "tsc --noEmit",
		"astro-check": "pnpm --filter frontend astro-check",
		"unused": "knip",
		"validate": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm astro-check",
		"postinstall": "lefthook install"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@semantic-release/git": "^10.0.1",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"knip": "^5.88.1",
		"lefthook": "^2.1.10",
		"lint-staged": "^15.5.2",
		"oxlint": "^1.78.0",
		"oxlint-tsgolint": "^7.0.2001",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^0.14.1",
		"semantic-release": "^24.2.9",
		"tsx": "^4.23.12",
		"typescript": "^5.9.3"
	}
}
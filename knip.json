{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreDependencies": ["@typescript/native", "lint-staged", "tsx"],
  "ignoreBinaries": ["uv"],
  "workspaces": {
    "frontend": {
      "entry": [
        "src/pages/**/*.astro",
        "src/types/**"
      ],
      "project": [
        "**/*.{js,mjs,cjs,ts,jsx,tsx,astro}",
        "!node_modules/**",
        "!dist/**",
        "!.astro/**",
        "!src/shared/components/ui/starwind/**",
        "!src/shared/components/ui/starwind/**"
      ],
      "ignoreDependencies": [
        "@fontsource-variable/inter",
        "@fontsource-variable/newsreader",
        "@fontsource/charis-sil",
        "@fontsource/crimson-text",
        "@fontsource/fragment-mono",
        "@fontsource/pinyon-script",
        "lodash",
        "@types/lodash",
        "@tabler/icons",
        "@tailwindcss/forms",
        "embla-carousel",
        "tailwind-merge",
        "tailwind-variants",
        "tailwindcss",
        "tw-animate-css",
        "prettier-plugin-astro"
      ]
    }
  },
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "tags": ["-lintignore"]
}

{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    "frontend": {
      "entry": [
        "src/pages/**/*.astro",
        "src/types/**"
      ],
      "project": [
        "**/*.{js,mjs,cjs,ts,jsx,tsx,astro}",
        "!node_modules/**",
        "!dist/**",
        "!.astro/**",
        "!src/components/starwind/**",
        "!src/lib/utils/starwind/**"
      ],
      "ignoreDependencies": [
        "@tabler/icons",
        "@tailwindcss/forms",
        "embla-carousel",
        "tailwind-merge",
        "tailwind-variants",
        "tailwindcss",
        "tw-animate-css",
        "prettier",
        "prettier-plugin-astro"
      ]
    }
  },
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "tags": ["-lintignore"]
}
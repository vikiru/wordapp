{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "bracketSpacing": true,
  "quoteProps": "as-needed",
  "sortImports": true,
  "sortTailwindcss": {
    "stylesheet": "frontend/src/styles/globals.css",
    "functions": ["cn", "clsx"],
    "preserveWhitespace": false
  },
  "ignorePatterns": [
    "frontend/src/shared/components/ui/starwind",
    "frontend/src/shared/components/ui/starwind",
    "frontend/node_modules",
    "frontend/dist",
    "frontend/.astro",
    "frontend/src/data",
    "frontend/**/*.astro",
    "frontend/**/*.css",
    "frontend/**/*.json"
  ]
}
